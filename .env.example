# LLM API Configuration
# LLM_PROVIDER: openai (DeepSeek/OpenAI 格式) 或 anthropic (Claude 格式)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai

# Server
PORT=3001

# Client
VITE_API_BASE=http://localhost:3001/api

# Logging (DEBUG / INFO / WARN / ERROR，默认 DEBUG)
LOG_LEVEL=DEBUG

# LLM call retry configuration
LLM_MAX_RETRIES=3

# Concurrent review task limit
MAX_CONCURRENT_TASKS=3
