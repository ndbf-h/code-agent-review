# LLM API Configuration
# LLM_PROVIDER: openai (DeepSeek/OpenAI compatible) or anthropic (Claude compatible)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai

# Server
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5433/code_agent_review

# RabbitMQ 任务队列（docker compose 内为 amqp://review:review@rabbitmq:5672/）
RABBITMQ_URL=amqp://review:review@localhost:5672/

# Client
VITE_API_BASE=http://localhost:3001/api

# Logging (DEBUG / INFO / WARN / ERROR, default: DEBUG)
LOG_LEVEL=DEBUG

# LLM call retry configuration
LLM_MAX_RETRIES=3
# 进程内 LLM 并发请求上限（worker 每任务约 5 路 LLM 调用）
LLM_MAX_CONCURRENCY=12

# 任务并发上限（worker consumer 的 prefetch）
MAX_CONCURRENT_TASKS=3

# 任务级重试：总尝试次数（含首次）与重试延迟
# 注意：修改延迟需先删除 RabbitMQ 中的 review.task.retry 队列（队列参数不可变）
TASK_RETRY_MAX_ATTEMPTS=2
TASK_RETRY_DELAY_MS=30000

# worker 心跳：上报间隔与判定“执行进程已死”的超时（sweeper 依此回收任务）
TASK_HEARTBEAT_INTERVAL_MS=30000
TASK_HEARTBEAT_STALE_MS=120000

# Langfuse 可观测性（可选，不配则为纯计数模式，指标落库不受影响）
# 启动栈：docker compose --profile observability up -d → http://localhost:3000 建组织/项目 → 生成 API 密钥
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000

# ── 混合 RAG（可选）──
# 检索模式：hybrid（默认，BM25+向量+RRF+重排，未配嵌入密钥自动降级 BM25 单分支）| legacy（词元打分）
# RAG_MODE=hybrid
# 多语言嵌入（推荐 SiliconFlow BAAI/bge-m3，有免费额度；任何 OpenAI 兼容 /embeddings 均可）
# 中文查询 ↔ 英文知识库的跨语言召回必须开启此分支
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 重排（可选，提升排序精度）
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# MCP Client（可选）：启动时挂载的外部 MCP Server，工具以 mcp_<别名>_<工具名> 注册
# 格式：alias=url 或纯 URL（逗号分隔）；容器内自指用 http://server:3001/mcp，本机开发用 http://localhost:3001/mcp
# MCP_CLIENT_SERVERS=http://server:3001/mcp

# 模型路由（可选，P1-5）：按审查角色指定模型，降低成本或提升关键维度质量
# 格式：role=model（同 provider 内切换）或 role=alias:model（跨 provider，需配 LLM_ROUTE_<别名>_*）
# 例：ROLE_MODELS=security=deepseek-reasoner, style=deepseek-chat
# 跨 provider 例：ROLE_MODELS=security=sf:deepseek-ai/DeepSeek-V3
#                 LLM_ROUTE_SF_BASE_URL=https://api.siliconflow.cn/v1
#                 LLM_ROUTE_SF_API_KEY=sk-xxx
# ROLE_MODELS=

# 语义缓存（P1-5）：相同代码+语言+模型+prompt 版本直接复用报告（零 LLM 成本）
# 失效方式：改 prompt 后递增 server/src/queue/consumer.ts 的 PROMPT_VERSION 常量
