{
  "name": "code-agent-review-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "eval": "tsx src/eval/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "cd .. && eslint server/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "acorn": "^8.16.0",
    "amqplib": "^0.10.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "helmet": "^8.1.0",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^10.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
